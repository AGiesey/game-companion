<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests: run against the Cosmos emulator (needs Docker) and the API hosted in memory. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.6.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCompanion.Api\GameCompanion.Api.csproj" />
    <!-- Lets CosmosFixture start the AppHost's Cosmos emulator. -->
    <ProjectReference Include="..\GameCompanion.AppHost\GameCompanion.AppHost.csproj" />
  </ItemGroup>

</Project>
