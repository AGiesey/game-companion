<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests: in memory, no Docker. Tests that need Cosmos or the running API go in GameCompanion.Api.IntegrationTests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCompanion.Api\GameCompanion.Api.csproj" />
  </ItemGroup>

</Project>
